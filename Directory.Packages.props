<Project>
  <!--
    依赖版本集中管理（ADR-0021）。版本与许可的核实见 docs/implementation/S0-04-版本与许可.md；
    升级一律经合并请求，大版本升级先在该文档登记理由。修改须框架负责人审核（.gitea/CODEOWNERS）。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- 全部项目共用的分析器（06 第 3.1 节） -->
  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.320" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!-- 数据访问 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <!-- Npgsql 的 EF 提供程序依赖较低的 Relational，与 Design 引入的 10.0.14 冲突（MSB3277），统一锁定 -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <!-- .NET 运行时扩展（与运行时补丁版本一致） -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
  </ItemGroup>

  <!-- 应用层：中介者、强类型 ID、校验 -->
  <ItemGroup>
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Vogen" Version="8.0.7" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <!-- 接口层、认证 -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>

  <!-- 可观测性、缓存、功能开关、韧性、脱敏 -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
  </ItemGroup>

  <!-- 后台处理、通知、文件 -->
  <ItemGroup>
    <PackageVersion Include="Quartz" Version="4.7.2" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Fluid.Core" Version="2.41.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.9" />
  </ItemGroup>

  <!-- 命令行程序（Kmic.MigrationRunner、Kmic.Operator）：Microsoft 官方，MIT -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>

  <!-- 阿里云：验证码 2.0、短信（R01 L1；阶段 3 引入时随依赖树再核一次许可） -->
  <ItemGroup>
    <PackageVersion Include="AlibabaCloud.SDK.Captcha20230305" Version="1.1.4" />
    <PackageVersion Include="AlibabaCloud.SDK.Dysmsapi20170525" Version="4.4.0" />
  </ItemGroup>

  <!-- 本地开发编排（Aspire.AppHost.Sdk 的版本在 global.json 中固定） -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
  </ItemGroup>

  <!-- 测试 -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- 测试基础设施库（Kmic.BuildingBlocks.Testing）只需要夹具接口，不引用整个 xunit.v3 -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.4" />
  </ItemGroup>

  <!--
    自定义分析器（Kmic.BuildingBlocks.Analyzers，netstandard2.0）及其测试（S0-04 #10）：
    Roslyn 锁 5.0.0（.NET 10 首个 SDK 自带的版本）。分析器按较低版本编写可以在更新的编译器上运行；
    且 EF Core 设计时工具（Microsoft.EntityFrameworkCore.Design）要求 Roslyn 工作区组件严格为 5.0.0，
    锁更高版本会在引用它的项目中造成依赖冲突（NU1608）。
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- 编译期为 netstandard2.0 补上新语法需要的类型，分析器代码也用最新写法 -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
  </ItemGroup>

  <!--
    传递依赖的安全修复（06 第 3.1 节：借助传递依赖锁定在此统一提升）。每项写明由谁引入、修复了什么；
    引入它的包升级后已不再需要时删除。
  -->
  <ItemGroup>
    <!-- 由 Microsoft.CodeAnalysis.CSharp.Analyzer.Testing 间接引入 9.0.6，存在 GHSA-846f-f764-76mx（高）、GHSA-2fmv-rv2c-59x7（中） -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
