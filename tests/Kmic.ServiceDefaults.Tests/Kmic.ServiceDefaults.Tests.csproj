<Project Sdk="Microsoft.NET.Sdk">
  <!--
    可观测性默认配置的测试：进程内的测试服务器，日志用内存里的接收器收集，追踪与指标用内存导出器，不需要数据库
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Hosts/Kmic.ServiceDefaults/Kmic.ServiceDefaults.csproj" />
    <ProjectReference Include="../../src/BuildingBlocks/Kmic.BuildingBlocks.Testing/Kmic.BuildingBlocks.Testing.csproj" />
  </ItemGroup>
</Project>
