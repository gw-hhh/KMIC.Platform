<Project Sdk="Microsoft.NET.Sdk">
  <!--
    一次性执行各模块的数据库迁移，并提供维护命令（清理只追加表的过期数据）。
    用迁移账号的连接串，只在部署流程里运行；应用本身的运行账号没有改表结构的权限（ADR-0029）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../BuildingBlocks/Kmic.BuildingBlocks.Infrastructure/Kmic.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Identity/Kmic.Identity.Infrastructure/Kmic.Identity.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Sample/Kmic.Sample.Infrastructure/Kmic.Sample.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Configuration/Kmic.Configuration.Infrastructure/Kmic.Configuration.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Operations/Kmic.Operations.Infrastructure/Kmic.Operations.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Files/Kmic.Files.Infrastructure/Kmic.Files.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Kmic.Notifications.Infrastructure/Kmic.Notifications.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kmic.Tools.Tests" />
  </ItemGroup>
</Project>
