<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    唯一的应用宿主：按配置 Kmic:Roles 以 Api、Worker 角色运行。
    AddMediator 要在这里调用——源码生成器只在调用它的项目里生成分发代码，所以所有模块的 Application 项目都要引用到这里
  -->
  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- 只在开发机上用 dotnet ef 生成迁移时需要，不进发布物 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../BuildingBlocks/Kmic.BuildingBlocks.Hosting/Kmic.BuildingBlocks.Hosting.csproj" />
    <ProjectReference Include="../../Aspire/Kmic.ServiceDefaults/Kmic.ServiceDefaults.csproj" />
    <ProjectReference Include="../../Modules/Identity/Kmic.Identity.Infrastructure/Kmic.Identity.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Identity/Kmic.Identity.Presentation/Kmic.Identity.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Sample/Kmic.Sample.Infrastructure/Kmic.Sample.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Sample/Kmic.Sample.Presentation/Kmic.Sample.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Configuration/Kmic.Configuration.Infrastructure/Kmic.Configuration.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Configuration/Kmic.Configuration.Presentation/Kmic.Configuration.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Operations/Kmic.Operations.Infrastructure/Kmic.Operations.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Operations/Kmic.Operations.Presentation/Kmic.Operations.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Files/Kmic.Files.Infrastructure/Kmic.Files.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Files/Kmic.Files.Presentation/Kmic.Files.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kmic.Api.Tests" />
  </ItemGroup>
</Project>
